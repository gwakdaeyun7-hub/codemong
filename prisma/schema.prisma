// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 인증/프로필은 Supabase Auth (auth.users + user_metadata)에 위임.
// 닉네임 등 표시 정보는 user_metadata.nickname 으로 저장한다.
// 학습 진도/이해도 등 도메인 데이터 모델은 backend 라운드에 추가 예정.
//
// Prisma 7에서 connection URL은 schema가 아니라 prisma.config.ts 에서 관리한다.

// ─── 커뮤니티 / 댓글 / 좋아요 / 신고 ─────────────────────────────
//
// Post: 커뮤니티 게시글 (Q&A | 자유)
// Comment: 댓글 — 영상(lessonRef) 또는 게시글(postId) 에 달림. 정확히 하나만.
//          parentId 가 있으면 답글 (1-depth 까지만 허용 — application code 에서 강제)
// PostLike / CommentLike: 좋아요 (복합 PK)
// PostReport / CommentReport: 신고 (사용자당 1회)
//
// 작성자 표시 정보(닉네임/아바타)는 작성 시점에 스냅샷으로 저장한다.
// 이유: Supabase auth.users 는 Prisma 외부 스키마라 join이 안 되고,
// service_role admin API 조회는 매번 외부 호출이라 느림. 닉네임을 바꾸면 신규 글에만 반영되는 트레이드오프를 허용.

enum PostCategory {
  question
  free
}

model Post {
  id              String       @id @default(cuid())
  authorId        String       @db.Uuid
  authorNickname  String
  authorAvatarUrl String?

  category        PostCategory
  title           String
  body            String

  resolved        Boolean      @default(false) // Q&A 해결 표시 (작성자만 토글)
  likeCount       Int          @default(0)     // PostLike 집계 캐시 — 정렬 성능용
  commentCount    Int          @default(0)     // Comment 집계 캐시

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?    // soft delete

  comments        Comment[]
  likes           PostLike[]
  reports         PostReport[]

  @@index([category, deletedAt, createdAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id              String          @id @default(cuid())
  authorId        String          @db.Uuid
  authorNickname  String
  authorAvatarUrl String?

  // 댓글이 게시글(postId) 또는 강의(lessonRef) 둘 중 하나에 달린다.
  // lessonRef 포맷: "<courseId>/<lessonId>" (예: "python/lesson-1")
  postId          String?
  lessonRef       String?

  // 답글이면 부모 댓글 id (1-depth 만 허용 — 답글의 답글은 application code 에서 차단)
  parentId        String?

  body            String
  likeCount       Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?       // soft delete — "삭제된 댓글입니다" 로 표시

  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")
  post            Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes           CommentLike[]
  reports         CommentReport[]

  @@index([postId, createdAt])
  @@index([lessonRef, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

model PostLike {
  postId    String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// 강의 좋아요. lesson은 Prisma 외부 (lib/lesson-plan.ts 정적 데이터) 라 외래키 대신 ref 문자열만.
// lessonRef 포맷: "<courseId>/<lessonId>"
model LessonLike {
  lessonRef String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([lessonRef, userId])
  @@index([userId])
  @@map("lesson_likes")
}

// 학습 진도 — 이수율/이해도 2층 구조. lesson은 Prisma 외부(정적 mock)라 lessonRef 문자열.
// lessonRef 포맷: "<courseId>/<lessonId>"
//  · 1층(이수율): 영상 90% 시청(videoWatchedAt) + 완료 버튼(learnCompletedAt) = "학습 완료"
//  · 2층(이해도): 퀴즈(Pool A) 통과(quizPassedAt, quizBestScore) = "이해 완료" — 퀴즈 화면 구현 후 2단계
// 이수율 = learnCompletedAt 있는 강의 / 전체. 이해도 = quizPassedAt 있는 강의 / 전체.
model LessonProgress {
  lessonRef        String
  userId           String    @db.Uuid
  videoWatchedAt   DateTime? // 영상 90% 도달 시점
  learnCompletedAt DateTime? // 완료 버튼 클릭 (= 학습 완료, 이수율 집계)
  quizPassedAt     DateTime? // 퀴즈 통과 (= 이해 완료, 이해도 집계)
  quizBestScore    Int? // 퀴즈 최고점 (0-100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@id([lessonRef, userId])
  @@index([userId])
  @@map("lesson_progress")
}

// 프로젝트형 강의(13강~) 진도. lesson은 Prisma 외부(정적 mock)라 lessonRef 문자열.
// lessonRef 포맷: "<courseId>/<lessonId>"
//  · stepStatuses : 스텝별 통과 여부 맵 { "step-1": true, ... }
//  · submittedCode: 스텝별 마지막 작성 코드 (이어하기용)
//  · completedAt  : 채점 스텝을 모두 통과한 시점 (= 프로젝트 학습 완료, 이수율 집계)
model ProjectProgress {
  lessonRef     String
  userId        String    @db.Uuid
  stepStatuses  Json      @default("{}")
  submittedCode Json      @default("{}")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@id([lessonRef, userId])
  @@index([userId])
  @@map("project_progress")
}

// 강별 연습 문제(exercise-content.ts) 통과 기록. lesson은 Prisma 외부(정적 mock)라 lessonRef 문자열.
// lessonRef 포맷: "<courseId>/<lessonId>" (예: "python/lesson-4")
//  · passed : 통과한 문제 id 맵 { "ex-1": true, "ex-2": true }
// 채점은 클라이언트(Pyodide)에서 수행하고 통과 결과(passed)만 멱등 기록한다.
// (ProjectProgress 와 동일한 "서버 재검증 안 함" 정책 — 신뢰가 필요해지면 얹는다.)
// 13강 ProjectProgress 와 별개 트랙이며, 이번 범위는 "통과 저장"만 — 이수율 연동은 별도.
model ExerciseProgress {
  lessonRef String
  userId    String   @db.Uuid
  passed    Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@id([lessonRef, userId])
  @@index([userId])
  @@map("exercise_progress")
}

// 강별 연습 문제 "제출 시도" 로그 — 성장 레이더(스파이더) 실데이터 소스.
// ExerciseProgress(통과 여부 멱등 맵)와 별개로, 제출 1건마다 한 행씩 append-only 로 쌓는다.
// (통과/오답 모두 기록 — 이게 있어야 첫시도 통과율·구문 정확도·로직 통과율 같은 "과정" 지표를 잰다.)
// 채점은 클라이언트(Pyodide, lib/project/grader.ts)에서 끝나고, 그 결과 요약만 기록한다(서버 재검증 X).
//  · hadError    : 실행 자체 실패(문법/런타임 예외)가 있었는지 — 구문 정확도 축 proxy
//  · errorType   : 첫 에러 종류("SyntaxError" 등) — 향후 오답 분류/논리성 축용 (없으면 null)
//  · casesPassed / casesTotal : 테스트케이스 통과/전체 — 로직 구현도 축 proxy
// lessonRef 포맷: "<courseId>/<lessonId>" (다른 진도 모델과 동일).
model ExerciseAttempt {
  id          String   @id @default(cuid())
  lessonRef   String
  userId      String   @db.Uuid
  exerciseId  String
  hadError    Boolean
  errorType   String?
  casesPassed Int
  casesTotal  Int
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([lessonRef, userId])
  @@map("exercise_attempts")
}

// ─── 실력향상(시험) 트랙 ─────────────────────────────────────
// 문제 은행(lib/problems/) 제출 기록. 백준 "내 제출" 스타일 append-only — 제출 1건 = 1행.
// 채점은 클라이언트(Pyodide, lib/project/grader.ts) — ExerciseAttempt 와 동일한 "서버 재검증 안 함" 정책.
// AI 피드백(개념/효율/해석 3축 + 힌트형 코멘트)은 제출 저장 "후" 서버가 Gemini 를 호출해
// 같은 행에 채우는 2단계 write — AI 실패/키 없음/한도 초과여도 제출·채점 기록은 항상 남는다.
enum AiFeedbackStatus {
  pending // 행 생성 직후 (AI 호출 전 — 액션이 중간에 죽으면 이 상태로 남음 = failed 취급)
  ok // 3축 점수 + 피드백 채움
  failed // 호출/파싱 실패 — 채점 결과만 표시
  skipped_no_key // GEMINI_API_KEY 미설정 (AI 기능 전체 off)
  skipped_limit // 무료 하루 한도 초과
}

model ProblemSubmission {
  id          String  @id @default(cuid())
  userId      String  @db.Uuid
  lessonRef   String // "<courseId>/<lessonId>" — 데이터 정식 courseId 기준 "be-python/lesson-N"
  problemId   String
  code        String // 제출 코드 원문 (서버에서 10KB 상한 컷)
  passed      Boolean // 공개+히든 전체 통과 여부
  hadError    Boolean // 실행 예외 여부 — 구문 정확도 축 proxy (ExerciseAttempt 규약)
  errorType   String? // "SyntaxError" 등 첫 에러 종류 (60자 컷)
  casesPassed Int
  casesTotal  Int
  caseResults Json    @default("[]") // [{label, passed, hidden}] — stdout 은 저장 안 함 (용량/유출)

  aiStatus            AiFeedbackStatus @default(pending)
  conceptScore        Int? // 0-100 (개념 이해도)
  efficiencyScore     Int? // 0-100 (코드 효율성)
  interpretationScore Int? // 0-100 (문제 해석력)
  aiFeedback          String? // 학습자용 한국어 힌트형 피드백 (정답 코드 미포함)
  aiDeductions        Json? // [{axis, reason, points}] 감점 근거
  aiModel             String? // "gemini-3.1-flash-lite" 스냅샷 (모델 교체 대비)
  promptTokens        Int? // Gemini usageMetadata 실측 — 비용 로깅 (aiStatus=ok 일 때만)
  outputTokens        Int? // 〃 (scripts/ai-usage.mjs 가 일별 집계·예상 비용 계산)

  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // 제출 히스토리 최신순 + 하루 한도 count
  @@index([userId, lessonRef]) // 단원별 레이더/해결 현황
  @@index([lessonRef, problemId]) // 문제별 코호트 통계 (향후)
  @@map("problem_submissions")
}

// 주간 성장 리포트 — "열 때 생성" (마이페이지/실력향상 진입 시 지난주 것이 없으면 생성).
// 유저·주당 1행 멱등 (복합 PK). LLM 코멘트 실패 시 llmComment 만 null (숫자 리포트는 유지).
model WeeklyReport {
  userId          String   @db.Uuid
  weekStart       DateTime @db.Date // 그 주 월요일 (KST 기준 날짜)
  submissionCount Int // 그 주 ProblemSubmission 수
  passRate        Int // 0-100 — 그 주 제출 통과율
  axisScores      Json // {syntax, logic, concept, efficiency, interpretation} 주말 시점 누적 스냅샷
  axisDeltas      Json // 전주 스냅샷 대비 변화 (전주 리포트 없으면 {})
  weakestAxis     String? // 최저 축 key — 규칙 기반 다음 문제 추천 seam
  llmComment      String? // Gemini 생성 코멘트 (실패/키 없음 null)
  createdAt       DateTime @default(now())

  @@id([userId, weekStart])
  @@map("weekly_reports")
}

model CommentLike {
  commentId String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model PostReport {
  id         String   @id @default(cuid())
  postId     String
  reporterId String   @db.Uuid
  reason     String   // "spam" | "abuse" | "off-topic" | "other"
  detail     String?  // 자유 입력 (other 일 때)
  createdAt  DateTime @default(now())

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId]) // 사용자당 1회
  @@index([createdAt])
  @@map("post_reports")
}

model CommentReport {
  id         String   @id @default(cuid())
  commentId  String
  reporterId String   @db.Uuid
  reason     String
  detail     String?
  createdAt  DateTime @default(now())

  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([createdAt])
  @@map("comment_reports")
}

// ─── 알림 ────────────────────────────────────────────────────
// 커뮤니티 기반 "내게 온 것만" 알림. 내 글에 댓글 / 내 댓글에 답글 /
// 내 글·댓글에 좋아요 4종. 본인→본인 행위는 생성하지 않는다(application code 에서 skip).
//
// 갱신 방식 = "열 때 조회"(폴링/Realtime 아님). 종 클릭/페이지 진입 시 서버 조회만.
// 알림은 부가 기능 — 생성 실패가 본래 액션(댓글/좋아요)을 깨면 안 되므로 best-effort 로 만든다.
//
// 행위자(actor) 표시 정보는 Comment/Post 와 동일하게 작성 시점 스냅샷으로 저장한다.
// (Supabase auth.users 는 Prisma 외부라 join 불가 — 닉네임 변경은 신규 알림에만 반영.)
//
// lesson/post 는 Prisma 외부(lessonRef) 또는 내부(postId) 참조라 외래키를 걸지 않는다.
// 대상이 soft delete 되어도 알림 행은 남되, 조회 시점에 이동 href 만 계산해 내려준다.
enum NotificationType {
  post_comment // 내 글에 댓글
  comment_reply // 내 댓글에 답글 (post/lesson 공통)
  post_like // 내 글에 좋아요
  comment_like // 내 댓글에 좋아요
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String           @db.Uuid // 알림 받는 userId
  actorId        String           @db.Uuid // 행위자 userId
  actorNickname  String // 스냅샷 (Comment/Post 패턴 동일)
  actorAvatarUrl String?

  type           NotificationType

  // 이동 대상 식별자 — 알림 타입에 따라 일부만 채워진다.
  postId         String? // post 관련(댓글/답글/좋아요)
  lessonRef      String? // lesson 댓글 답글이면 "<courseId>/<lessonId>"
  commentId      String? // 답글이 달린/좋아요 받은 댓글 id

  excerpt        String? // 미리보기 (댓글 본문 일부 또는 글 제목)
  readAt         DateTime? // 읽은 시점 (null = 안읽음)
  createdAt      DateTime         @default(now())

  @@index([recipientId, readAt]) // 안읽음 카운트
  @@index([recipientId, createdAt]) // 최신순 목록
  @@map("notifications")
}
